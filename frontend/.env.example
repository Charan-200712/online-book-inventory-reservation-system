# ==============================================================================
# Frontend Environment Configuration Template
# Copy this file to frontend/.env and update values for your environment.
# Note: VITE_* variables are embedded into the client-side JavaScript bundle.
# NEVER place secret tokens or private database credentials here.
# ==============================================================================

# Backend API base endpoint
# Local development default: http://localhost:5000/api
# Deployed production example: https://api.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:5000/api
