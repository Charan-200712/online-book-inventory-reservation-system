# ==============================================================================
# Backend Environment Configuration Template
# Copy this file to backend/.env and update values for your environment.
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO VERSION CONTROL.
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# CORS Allowed Origin(s)
# Single origin: http://localhost:5173
# Multiple origins (comma-separated): http://localhost:5173,https://library.yourdomain.com
CLIENT_URL=http://localhost:5173

# MySQL Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_secure_database_password
DB_NAME=library_db

# JWT Authentication Secret & Token Lifespan
# In production, use a high-entropy cryptographically secure string (min 32 characters)
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=1h

# Library Business Rules (Default loan period in days)
BOOK_LOAN_DAYS=14
