# ==============================================================================
# Online Book Inventory & Reservation System - Root Environment Template
# Copy this file or configure backend/.env and frontend/.env respectively.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# CORS Allowed Origin(s)
# Supports single origin or comma-separated list of allowed origins:
CLIENT_URL=http://localhost:5173

# MySQL Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_secure_database_password
DB_NAME=library_db

# JWT Authentication
# Minimum 32-character high-entropy secret string
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=1h

# Circulation Business Logic (Loan duration in days)
BOOK_LOAN_DAYS=14

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
# API Base URL consumed by Vite React frontend
# Never place backend secrets in VITE_* variables
VITE_API_BASE_URL=http://localhost:5000/api
