# ==============================================================================
# Online Book Inventory & Reservation System - Root Environment Configuration Template
# Copy this file or configure backend/.env and frontend/.env respectively.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
# Server Port & Allowed Origin
PORT=5000
CLIENT_URL=http://localhost:5173

# MySQL Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=library_db

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=1h

# Business Logic Settings
BOOK_LOAN_DAYS=14

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
# API Base URL consumed by Vite React frontend
VITE_API_BASE_URL=http://localhost:5000/api
